# Valid APP_ENV values: local, development, dev, test, staging, production, prod
# Production and staging must not use SQLite; they require a real MariaDB/MySQL URL.
APP_ENV=local
APP_SECRET=change-me-to-a-long-random-secret
DATABASE_URL=mysql+pymysql://thrivematrix:thrivematrix@localhost:3306/thrivematrix
REDIS_URL=redis://localhost:6379/0
MARIADB_DATABASE=thrivematrix
MARIADB_USER=thrivematrix
MARIADB_PASSWORD=thrivematrix
MARIADB_ROOT_PASSWORD=rootpass
MINIO_ROOT_USER=localadmin
MINIO_ROOT_PASSWORD=localadmin
SESSION_DB_PATH=./api/data/thrivematrix_sessions.db
SECURITY_COOKIE_SECURE=false
SECURITY_COOKIE_SAMESITE=lax